{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run typecheck)",
      "Bash(npx eslint *)",
      "Bash(npm run lint*)",
      "Bash(npx vitest run*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run eval:*)",
      "Bash(npm run style:lint)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git worktree list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(node -e *)",
      "Bash(npx tsx --tsconfig tsconfig.json /tmp/*)"
    ],
    "deny": [
      "Bash(npm run dev*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_FILE_PATHS\"; case \"$f\" in *.ts|*.tsx|*.mjs|*.js) npx eslint --fix \"$f\" >/dev/null 2>&1 || true ;; esac"
          }
        ]
      }
    ]
  }
}
