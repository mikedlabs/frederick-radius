# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev tooling
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-cli/

# data pipeline: raw and clean snapshots live on the data-snapshots
# branch, never on main, to keep history small.
/data/raw/
/data/clean/

# editor review state (dev-mode admin tools). Decisions persist locally
# only — the editor commits the resulting merges manually.
/data/discovered-decisions.json
/data/drift-decisions.json
/data/place-drift.json
scripts/find-duplicates-report.json
# Lighthouse / perf audit snapshots: local-only, do not commit
.perf/
scripts/.lighthouse/
.env*.local
/index.mjs
/index.ts

# Visual-verification output (scripts/screenshots.mjs)
screenshots/

# Local-only UX simulation harness + its screenshot output (scratch)
ux-sim.mjs
ux-shots/

# Local browser-audit captures and generated quality reports
/output/
/tmp/
__pycache__/

# Generated mockup renders (reproducible from the .html + render script)
.mockups/render/
.mockups/*.built.html

# Historical design explorations and generated review evidence are archived
# outside the production repository. Their source scripts remain reproducible.
/.mockups/
/design-log/
/design-review/probes/
/public/brand/campaign/*
!/public/brand/campaign/cartographic-ripple-background.png

# Scratch render / audit / smoke scripts (agent + local Playwright runs)
/_*.mjs
/audit*.mjs
/*-run.mjs
/*_tmp.mjs
/.render-*.mjs
.city-maps/
audit-reports/

# Generated data-review outputs. Keep the compact vendor rights manifest, but
# regenerate these local reports instead of committing snapshots.
/audit/chij-backfill-uncertain.json
/audit/dfp-mash-followup.json
/audit/dfp-mash-verification.json
/audit/dfp-sample-50.json
/audit/photo-twins.json
/audit/suspected-duplicates.csv
# Vendor media downloads are a local rights-review queue. The compact source
# manifest is tracked; original website files are deliberately not deployed.
/audit/vendor-media/downloads/
# Design-review evidence: the report is tracked; the ~68MB of PNG captures
# are regenerable and stay out of git history.
design-review/screenshots/
# Closure-detector output: a local review artifact, regenerated each run.
scripts/reports/
# County basemap extract: ~30MB binary produced at build time by
# scripts/fetch-basemap.mjs (pinned Protomaps build + bbox). Tracking it
# would rewrite the whole blob on every refresh; the repo-size gate says no.
public/basemap/frederick-county.pmtiles
# Basemap style assets: sprites + glyph ranges, fetched at build time beside
# the county extract by scripts/fetch-basemap.mjs. Never tracked.
public/basemap/fonts/
public/basemap/sprites/
