{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/warm-events",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/event-archive",
      "schedule": "4,34 * * * *"
    },
    {
      "path": "/api/cron/warm-map",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/ingest/civicengage",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/ingest/fcpl",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/ingest/fcvfra",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/notify-civic-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/notify-traffic-alerts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/scanner-archive",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/data-health-feeds",
      "schedule": "5 */2 * * *"
    },
    {
      "path": "/api/cron/runtime-source-health",
      "schedule": "43 */2 * * *"
    },
    {
      "path": "/api/cron/data-health",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "3 12,13 * * *"
    },
    {
      "path": "/api/cron/hours-refresh",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/radius-search",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/spatial-places",
      "schedule": "20 8 * * *"
    },
    {
      "path": "/api/cron/parking-forecast",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/golden-hour",
      "schedule": "*/15 20-23,0-1 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/food-truck-schedules",
      "schedule": "15 */4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/fair/2026/current.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/fair/2026/releases/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/history-photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ]
}
