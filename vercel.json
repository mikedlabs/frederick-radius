{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/warm-events",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/saved-reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/ingest/all",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/ingest/fcpl",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/ingest/fcvfra",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/notify-civic-alerts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/notify-traffic-alerts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/scanner-archive",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/business-status",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/data-health",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 12,13 * * *"
    },
    {
      "path": "/api/cron/rain-tomorrow",
      "schedule": "0 22,23 * * *"
    },
    {
      "path": "/api/cron/first-saturday",
      "schedule": "0 19,20 * * 6"
    },
    {
      "path": "/api/cron/hours-refresh",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/radius-search",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/link-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/parking-alerts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/parking-forecast",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/golden-hour",
      "schedule": "*/15 20-23,0-1 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/food-truck-schedules",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/history-photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ]
}
