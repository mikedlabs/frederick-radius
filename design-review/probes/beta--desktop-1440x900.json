    {
      "selector": "div:nth-of-type(2) > main > div:nth-of-type(1) > section > p",
      "text": "Everything worth doing is out there. Finding it means a dozen tabs: stale calendars, dead links, and a different page for every town.",
      "chars": 133,
      "estimatedLines": 3,
      "estimatedCharsPerLine": 44.3,
      "width": 416.4,
      "fontSize": "15px",
      "lineHeight": "24.375px"
    },
    {
      "selector": "main > div:nth-of-type(2) > section > div > p",
      "text": "One link. No app store. Everything below is on right now.",
      "chars": 57,
      "estimatedLines": 2,
      "estimatedCharsPerLine": 28.5,
      "width": 378.5,
      "fontSize": "15px",
      "lineHeight": "24.375px"
    },
    {
      "selector": "div:nth-of-type(2) > main > div:nth-of-type(3) > section > p",
      "text": "Not a brochure. These are the county’s numbers, right now.",
      "chars": 58,
      "estimatedLines": 1,
      "estimatedCharsPerLine": 58,
      "width": 784,
      "fontSize": "10.5px",
      "lineHeight": "15.75px"
    },
    {
      "selector": "div:nth-of-type(2) > main > div:nth-of-type(4) > section > p",
      "text": "Save the ones you love. They land in your pocket, each with a plate number and its open-now line.",
      "chars": 97,
      "estimatedLines": 2,
      "estimatedCharsPerLine": 48.5,
      "width": 480,
      "fontSize": "14px",
      "lineHeight": "22.75px"
    },
    {
      "selector": "div:nth-of-type(6) > section > div:nth-of-type(2) > div:nth-of-type(1) > p",
      "text": "It knows what's open now, what's on tonight, and what's worth the drive. Ask in plain words.",
      "chars": 92,
      "estimatedLines": 3,
      "estimatedCharsPerLine": 30.7,
      "width": 245.3,
      "fontSize": "14px",
      "lineHeight": "22.75px"
    },
    {
      "selector": "div:nth-of-type(6) > section > div:nth-of-type(2) > div:nth-of-type(2) > p",
      "text": "Field notes on the taproom patio, the trail with the overlook, the diner that means it. Not scraped.",
      "chars": 100,
      "estimatedLines": 3,
      "estimatedCharsPerLine": 33.3,
      "width": 245.3,
      "fontSize": "14px",
      "lineHeight": "22.75px"
    },
    {
      "selector": "div:nth-of-type(6) > section > div:nth-of-type(2) > div:nth-of-type(3) > p",
      "text": "Weather, the game, the market, road closures, a heat cancellation. The county as it actually is, right now.",
      "chars": 107,
      "estimatedLines": 3,
      "estimatedCharsPerLine": 35.7,
      "width": 245.3,
      "fontSize": "14px",
      "lineHeight": "22.75px"
    },
    {
      "selector": "div:nth-of-type(2) > main > div:nth-of-type(7) > section > p:nth-of-type(3)",
      "text": "Have an access code? Scroll back up and come in. No code? Leave your email and we’ll send you one right away.",
