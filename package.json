    "optimize:seasons": "tsx --tsconfig tsconfig.json scripts/optimize-seasonal-photos.ts",
    "maps:download": "tsx --tsconfig tsconfig.json scripts/download-city-maps.ts",
    "audit:readiness": "tsx --tsconfig tsconfig.json scripts/audit/readiness.ts",
    "audit": "tsx --tsconfig tsconfig.json scripts/audit/run.ts",
