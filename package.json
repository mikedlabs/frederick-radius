{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "style:lint": "tsx --tsconfig tsconfig.json scripts/style-lint.ts",
    "perf": "tsx --tsconfig tsconfig.json scripts/lighthouse-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "enrich": "tsx --tsconfig tsconfig.json scripts/enrich-places.ts",
    "discover": "tsx --tsconfig tsconfig.json scripts/discover-places.ts",
    "audit:data": "tsx --tsconfig tsconfig.json scripts/audit-data.ts",
    "gen:dedup": "tsx --tsconfig tsconfig.json scripts/gen-dedup.ts",
    "data:review": "tsx --tsconfig tsconfig.json scripts/data-review.ts",
    "prune:enrichment": "tsx --tsconfig tsconfig.json scripts/prune-enrichment.ts",
    "ingest:candidates": "tsx --tsconfig tsconfig.json scripts/ingest-candidates.ts",
    "enrich:discovered": "tsx --tsconfig tsconfig.json scripts/enrich-discovered.ts",
    "merge:discovered": "tsx --tsconfig tsconfig.json scripts/merge-discovered.ts",
    "vet": "tsx --tsconfig tsconfig.json scripts/vet-places.ts",
    "push:keys": "tsx --tsconfig tsconfig.json scripts/push-keys.ts",
    "build:discovered": "tsx --tsconfig tsconfig.json scripts/build-discovered-places.ts",
    "ingest": "tsx --tsconfig tsconfig.json scripts/run-ingest.ts",
    "dedup": "tsx --tsconfig tsconfig.json scripts/dedup.ts",
    "find-dupes": "tsx --tsconfig tsconfig.json scripts/find-duplicates.ts",
    "find-dupes:apply": "tsx --tsconfig tsconfig.json scripts/find-duplicates.ts --auto-merge && tsx --tsconfig tsconfig.json scripts/dedup.ts",
    "closures:report": "tsx --tsconfig tsconfig.json scripts/closures-report.ts",
    "coord:audit": "tsx --tsconfig tsconfig.json scripts/coord-audit.ts",
    "refresh:business-status": "tsx --tsconfig tsconfig.json scripts/refresh-business-status.ts",
    "copy:scores": "tsx --tsconfig tsconfig.json scripts/copy-scores.ts",
    "pipeline:fetch": "tsx --tsconfig tsconfig.json pipeline/fetch_all.ts",
    "pipeline:freshness": "tsx --tsconfig tsconfig.json pipeline/freshness_check.ts",
    "build:amenities": "tsx --tsconfig tsconfig.json scripts/build-amenities.ts",
    "build:client-places": "tsx --tsconfig tsconfig.json scripts/build-client-places.ts",
    "optimize:images": "tsx --tsconfig tsconfig.json scripts/optimize-images.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.24",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "^0.554.0",
    "mapbox-gl": "^3.23.1",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.6",
    "node-ical": "^0.26.1",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7"
