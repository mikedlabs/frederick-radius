    "pretest:watch": "npm run build:client-places",
    "test:watch": "vitest",
    "test:node": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:release": "BETA_PASSWORD=release-gate-sentinel PW_PRODUCTION=1 playwright test e2e/release-smoke.spec.ts e2e/event-link-release-contract.spec.ts e2e/topbar-destinations.spec.ts e2e/transit-rider.spec.ts e2e/deals-browser.spec.ts --project=chromium --workers=1 --retries=1",
