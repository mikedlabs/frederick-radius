# Frederick Radius environment template
# Copy to .env.local for local work. Never commit real values.

# Core public URLs and browser-safe keys
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser map token. Restrict it to Frederick Radius production/preview URLs.
# A validated bundled fallback remains during the migration.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Owner-only Standard basemap evaluation. Leave unset in production. Use
# `query` on a preview deployment, then open /map?basemap=standard; use `1`
# only when the entire preview deployment should render Standard.
NEXT_PUBLIC_MAPBOX_STANDARD_PREVIEW=

# Dedicated server-side token for Static Images, Directions, Isochrone, Matrix,
# Search Box, and stored geocoding. Every newly metered feature below stays off
# until its own circuit breaker is deliberately enabled.
MAPBOX_SERVER_TOKEN=
MAPBOX_GEOCODING_ENABLED=0
MAPBOX_MATRIX_ENABLED=0
MAPBOX_SEARCH_BOX_ENABLED=0

# Server data and protected routes
DATABASE_URL=
DIRECT_URL=
CRON_SECRET=
ADMIN_USER=
ADMIN_PASSWORD=
BETA_PASSWORD=
COLLECT_PASSCODE=

# Ask Radius and private hybrid search
# Text generation can use Vercel's injected VERCEL_OIDC_TOKEN instead of a
# gateway key. AI Gateway does not support embeddings; OPENAI_API_KEY is
# optional and adds semantic recall to the always-available Postgres FTS index.
ASK_AI_PROVIDER=gateway
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RADIUS_HYBRID_SEARCH=1
RADIUS_SEARCH_CRON=0
RADIUS_SEARCH_CRON_BATCH=256
RADIUS_EMBEDDING_MODEL=text-embedding-3-small

# Enable only after confirming a recent Supabase backup. The separately
# scheduled retention worker is inert without this flag; when enabled, it
# removes bounded oldest-first batches beyond the documented retention window.
DATA_RETENTION_PRUNE=0

# Places, hours, and local signals
GOOGLE_PLACES_API_KEY=
HOURS_REFRESH_CRON=0
BUSINESS_STATUS_CRON=0
AIRNOW_API_KEY=
NPS_API_KEY=
NWS_USER_AGENT=
MAPILLARY_TOKEN=
PARKING_OCCUPANCY_URL=
PARKING_OCCUPANCY_KEY=

# Event sources
TICKETMASTER_API_KEY=
BANDSINTOWN_APP_ID=
EVENTBRITE_TOKEN=
FCPS_FEED_URL=
HOOD_CALENDAR_URL=

# Email, uploads, and notifications
RESEND_API_KEY=
RESEND_FROM=
# Where owner notifications land: public submissions and food-truck claims.
# Defaults to hello@frederickradius.app when unset. Without RESEND_API_KEY
# nothing is sent at all and the durable database row is the only record.
ADMIN_EMAIL=
BLOB_READ_WRITE_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Distributed application rate limits are optional because Vercel Firewall
# protects the public production endpoints. These add durable in-app buckets.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Analytics and error reporting
# The checked-in Plausible script is used unless NEXT_PUBLIC_PLAUSIBLE_SRC is set.
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Plausible's server-side Stats API requires a plan that includes API access.
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Web push signing and member-cookie rotation
MEMBER_COOKIE_SECRET=
MEMBER_COOKIE_SECRET_PREVIOUS=
BETA_CODE_SECRET=
BETA_CODE_SECRET_PREVIOUS=
