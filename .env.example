# Frederick Radius environment template
# Copy to .env.local for local work. Never commit real values.

# Core public URLs and browser-safe keys
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser map token. A `pk.` token necessarily ships in the client bundle, so
# the only thing standing between it and someone else's bill is the URL
# restriction: set one in the Mapbox dashboard (Account > Tokens > the token >
# URL restrictions) naming https://frederickradius.app and the exact preview
# origin. Mapbox restrictions do not support wildcard characters; an origin
# entry already authorizes its subpaths.
#
# There is no source-controlled fallback. Leaving this unset makes interactive
# maps fail visibly instead of borrowing an exposed credential. Run
# `npm run verify:credentials -- --probe` after setting it; the probe must
# accept Radius and reject unrelated/no-origin requests.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Dedicated server-side token for Static Images, Directions, Isochrone, Matrix,
# Search Box, and stored geocoding. It MUST be a different token from the one
# bundled in the browser. These APIs need no secret account scopes, so prefer a
# separate non-default `pk.` token with public scopes only (`styles:tiles` is
# required when Static Images is enabled). Server routes never fall back to
# NEXT_PUBLIC_MAPBOX_TOKEN; an unset value fails closed on a cache miss.
MAPBOX_SERVER_TOKEN=
MAPBOX_GEOCODING_ENABLED=0
# Dedicated request-priced API breakers. Existing cached locator images,
# walking legs, and reach polygons can still render while the switch is off;
# every new cache miss stays local unless its exact switch is 1 and its cap is
# nonzero.
MAPBOX_STATIC_MAPS_ENABLED=0
MAPBOX_DIRECTIONS_ENABLED=0
MAPBOX_ISOCHRONE_ENABLED=0
# Global Matrix breaker for Ask, map search, and the Within reach route.
# Nothing reserves an allowance or calls Mapbox unless this is 1 and the daily
# element cap below is greater than zero. Matrix responses are not persisted.
MAPBOX_MATRIX_ENABLED=0
MAPBOX_SEARCH_BOX_ENABLED=0
# Aggregate Eastern-day breakers in the units Mapbox bills for these paths.
# Invalid values use 75 Search Box sessions and 20 permanent geocodes;
# configured values cannot exceed the code-owned 250/50 maxima. These paths
# reserve atomically before an uncached paid request and fail closed if the
# shared database counter is unavailable. Search Box also requires migration
# 0045: its hashed lifecycle ledger closes a UUID after retrieve, 180 seconds,
# or 50 suggestions, so one browser token can never become a day-long session.
MAPBOX_SEARCH_BOX_DAILY_SESSION_CAP=75
MAPBOX_PERMANENT_GEOCODING_DAILY_CAP=20
# Static Images, Directions, and Isochrone are billed per request. Their
# Eastern-day reservations happen only inside a cache miss. Set any cap to 0
# for an immediate token-preserving kill switch. Invalid values use the bounded
# 500/250/100 defaults; code cannot exceed the 1,000/500/250 maxima.
MAPBOX_STATIC_DAILY_REQUEST_CAP=500
MAPBOX_DIRECTIONS_DAILY_REQUEST_CAP=250
MAPBOX_ISOCHRONE_DAILY_REQUEST_CAP=100
# One origin by N destinations reserves N Matrix elements. Set 0 to disable
# every paid Matrix path without removing the token. Invalid values use 1,000;
# configured values cannot exceed the code-owned 3,000 maximum.
MAPBOX_MATRIX_DAILY_ELEMENT_CAP=1000

# Server data and protected routes
DATABASE_URL=
DIRECT_URL=
CRON_SECRET=
ADMIN_USER=
ADMIN_PASSWORD=
# Legacy invite/identity signing fallback. This does not gate public pages.
BETA_PASSWORD=
BETA_CODE_SECRET=
BETA_CODE_SECRET_PREVIOUS=
MEMBER_COOKIE_SECRET=
COLLECT_PASSCODE=

# Ask Radius and private hybrid search
# Text generation can use Vercel's injected VERCEL_OIDC_TOKEN instead of a
# gateway key. This search-index writer currently creates optional semantic
# vectors only through direct OpenAI, so OPENAI_API_KEY is required for that
# layer. It remains optional for the product: Postgres FTS is the dependable
# baseline when the key is absent.
# Public model work is off by default. When enabled, every model turn must
# reserve one unit in the shared Eastern-day database counter before provider
# work. Invalid limits use 250; configured values cannot exceed the code-owned
# 1,000-call maximum. Set the switch to 0 or the cap to 0 for an immediate kill
# switch. Cache hits and deterministic Frederick answers do not use the budget.
ASK_AI_RUNTIME_ENABLED=0
ASK_AI_DAILY_CALL_LIMIT=250
# One selected provider only; provider failures fall back to the local answer
# and never waterfall into a second bill. Supported values: gateway,
# anthropic, openai. An omitted setting defaults to Gateway; a blank or
# unsupported configured value fails closed instead of selecting another bill.
ASK_AI_PROVIDER=gateway
# Optional multi-step Gateway tool agent. It can use up to five separately
# reserved model turns for one complex request, so it is explicit opt-in.
# Single-shot Ask and every deterministic/local fallback still work when off.
ASK_RADIUS_AGENT=0
# Every provider path, including agent steps, is clamped to at most 600 output
# tokens in code. Invalid or zero values use the safe 400-token default.
ASK_AI_MAX_OUTPUT_TOKENS=400
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Review-only web evidence and exact-page extraction. These keys must remain
# server-side. Firecrawl can also recover the fixed Visit Frederick feed after
# written factual-reuse permission is documented; it never runs inside a
# visitor request.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_FETCH_FALLBACK=0
# Review-only Apify source-change radar. The token stays operator-side or in
# the GitHub APIFY_TOKEN environment. Its scheduled checks are exact-URL
# allowlisted, budget-capped, and cannot publish Radius data.
APIFY_TOKEN=
# Keep the Visit Frederick snapshot route dormant until written factual-reuse
# permission is documented. Enabling this flag is a deliberate legal/ops step;
# it is not implied by having a Firecrawl key.
VISIT_FREDERICK_FACTS_REUSE_APPROVED=0
# Operator extraction only. An activated Visit Frederick worker has its own
# immutable database-backed ceiling of 12 recovery attempts per Eastern day.
FIRECRAWL_FALLBACK_MAX_REQUESTS=1
RADIUS_HYBRID_SEARCH=1
RADIUS_SEARCH_CRON=0
RADIUS_SEARCH_CRON_BATCH=256
RADIUS_EMBEDDING_MODEL=text-embedding-3-small
# Scheduled vectors are a separate paid enhancement over the required
# Postgres full-text index. A key alone never enables them. Keep the switch and
# zero-default document allowance off until migration 0017's usage counter and
# unique index are verified. Code clamps the daily allowance to 512 documents.
RADIUS_SEARCH_SEMANTIC_ENABLED=0
RADIUS_SEARCH_EMBEDDING_DAILY_DOCUMENT_LIMIT=0
# Optional semantic recall during a visitor's Ask request is separate from the
# scheduled index writer. Leave it off unless the added recall is worth the
# direct OpenAI spend. Each runtime embedding reserves atomically; invalid
# limits use 100, code cannot exceed 500, and zero is a kill switch. Postgres
# full-text search remains available when this is off or the counter is down.
ASK_AI_RUNTIME_EMBEDDINGS_ENABLED=0
ASK_AI_EMBEDDING_DAILY_LIMIT=100

# PostGIS nearby rollout. Keep reads off until migration 0037 is verified and
# db:spatial:sync reports current=true. "shadow" compares after the response;
# "on" serves checksum-verified PostGIS distances with automatic fallback.
RADIUS_POSTGIS_SYNC=0
RADIUS_POSTGIS_NEARBY=off

# Operator-only until a recent Supabase backup is confirmed. The route is not
# in vercel.json; an authenticated deliberate run with this flag removes one
# bounded oldest-first batch beyond the documented retention window.
DATA_RETENTION_PRUNE=0

# Places, hours, and local signals
# Google maintenance, Routes, and event-address geocoding are fail-closed even
# when credentials exist. Leave these switches inert unless reviewed written
# authorization covers Radius's exact storage, attribution, derivative-data,
# and non-Google-map use. The approval value must be exactly
# `written-google-authorization-confirmed`; credentials alone never activate
# those maintenance or enrichment paths. Existing place-photo delivery is a
# separate, already-live path described below.
GOOGLE_MAPS_PLATFORM_POLICY_APPROVAL=
GOOGLE_MAPS_PLATFORM_RUNTIME_ENABLED=0
GOOGLE_PLACES_API_KEY=
# Existing place photos remain available through the key-safe same-origin
# proxy. The route preserves exact attribution, returns Google media private
# and no-store, applies per-minute abuse protection, and reserves from the
# aggregate Eastern-day allowance below before every upstream attempt.
# Routes requires a key restricted to the Routes API plus its own switch. It
# never falls back to GOOGLE_PLACES_API_KEY and never persists route results.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_ENABLED=0
# Event-address geocoding has its own policy, storage, and cost boundary. It
# requires the platform approval/runtime settings plus
# BOTH this dedicated key and the switch below. GOOGLE_PLACES_API_KEY is never
# a geocoding fallback. The public Frederick County address service remains the
# first provider and works without Google.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_ENABLED=0
# Shared Eastern-day breaker for unique Google event-address cache misses.
# Invalid values use 25; configured values cannot exceed the code-owned 100
# maximum. Set 0 to disable this paid fallback without removing credentials.
GOOGLE_EVENT_GEOCODE_DAILY_LIMIT=25
# Aggregate photo-proxy spike breaker per Eastern day. Missing or malformed
# values use 1,500; numeric values are clamped to 1-2,000. The 1,500 default is
# above the measured 30-day p95, so ordinary browsing keeps its business photos
# while bots, retry loops, and accidental eager rendering remain bounded.
GOOGLE_PHOTO_DAILY_CAP=1500
# One Eastern-day allowance shared by scheduled hours refreshes, retries, and
# authenticated cycle-day recovery. Complete current buckets are 208-273.
GOOGLE_HOURS_REFRESH_DAILY_CAP=300
# Element-priced Routes breaker. Current peak is 36/day; the immutable 160
# maximum stays below the current 5,000/month Pro free allowance at 31 days.
GOOGLE_ROUTES_DAILY_ELEMENT_CAP=100
# Shared daily ceilings for deliberate on-demand place enrichment. Invalid
# values use the safe defaults; numeric values cannot exceed 80/20.
GOOGLE_PLACE_ENRICH_DAILY_CAP=10
GOOGLE_PLACE_EXPERIENCE_DAILY_CAP=5
HOURS_REFRESH_CRON=0
# Manual legacy diagnostic only. This route is intentionally not scheduled;
# hours-refresh already collects business status in the same paid call.
BUSINESS_STATUS_CRON=0
LINK_HEALTH_CRON=0
# Runtime brewery discovery stays off unless explicitly enabled.
RADIUS_OBDB=0
AIRNOW_API_KEY=
NPS_API_KEY=
MAPILLARY_ENABLED=0
MAPILLARY_TOKEN=
PULSEPOINT_ENABLED=0
PULSEPOINT_AGENCY_ID=
PARKING_OCCUPANCY_ENABLED=0
PARKING_OCCUPANCY_URL=
PARKING_OCCUPANCY_KEY=
# Official public County GIS reads are enabled by default. Set this to 0 only
# as an operational kill switch; Radius requests allowlisted fields directly
# from the source and does not expose a bulk mirror.
FREDERICK_COUNTY_GIS_ENABLED=1
# Separate approval boundary for the non-GIS licensed-roster document,
# attachment-bearing recreation survey, and dead legacy facilities ingest.
# Approval for one source must not unlock the others.
# Known gated ids: fc_food_truck_roster, fc_recreation_locations,
# fc_county_facilities.
FREDERICK_COUNTY_GIS_REUSE_APPROVED=0
FREDERICK_COUNTY_GIS_APPROVED_SOURCES=

# Event sources
TICKETMASTER_API_KEY=
BANDSINTOWN_ENABLED=0
BANDSINTOWN_APP_ID=
SEATGEEK_ENABLED=0
SEATGEEK_CLIENT_ID=
EVENTBRITE_ENABLED=0
EVENTBRITE_TOKEN=
FCPS_FEED_URL=
HOOD_CALENDAR_URL=

# Email, uploads, and notifications
RESEND_API_KEY=
RESEND_FROM=
# Where owner notifications land: public submissions and food-truck claims.
# Defaults to hello@frederickradius.app when unset. Without RESEND_API_KEY
# nothing is sent at all and the durable database row is the only record.
ADMIN_EMAIL=
BLOB_READ_WRITE_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Scheduled push features ship disabled until their data and message flow have
# been verified in production.
SAVED_REMINDERS_ENABLED=0
RAIN_TOMORROW_ENABLED=0
FIRST_SATURDAY_ENABLED=0

# Distributed application rate limits are optional because Vercel Firewall
# protects the public production endpoints. These add durable in-app buckets.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Operational alerting. BOTH channels are currently unset in production, which
# is why a real incident stayed invisible: the anomaly detector correctly
# reported places-hours-refresh.json:snapshot_expired every night while the
# open-now feature was dark for a week, and with no channel configured it wrote
# that to a server log nobody reads. Detection has never been the problem here.
#
# SLACK_WEBHOOK_URL is the live anomaly stream (src/lib/integrations/alerts.ts):
# data-health anomalies, cache-warm failures. Create at api.slack.com/apps >
# your app > Incoming Webhooks > Add New Webhook to Workspace, then paste the
# https://hooks.slack.com/services/... URL. Repeat alerts with the same
# fingerprint are suppressed, so this will not become noise.
SLACK_WEBHOOK_URL=
# GITHUB_ALERTS_TOKEN opens and updates the nightly "[data-health] Red checks
# on the nightly board" issue plus the weekly digest
# (src/lib/integrations/github-alerts.ts). Needs Issues read/write on the repo
# below and nothing else; a fine-grained PAT scoped to this one repository is
# the right shape. Independent of Slack: this one survives Slack being down,
# and it is the channel that leaves a durable record.
GITHUB_ALERTS_TOKEN=
# Defaults to mikedlabs/frederick-radius when unset.
GITHUB_ALERTS_REPO=

# Analytics and error reporting
# The checked-in Plausible script is used unless NEXT_PUBLIC_PLAUSIBLE_SRC is set.
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Plausible's server-side Stats API requires a plan that includes API access.
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
